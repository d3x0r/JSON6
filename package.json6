// source file for package.json
// use npm build to produce normalized package.json file.


{
    name: "json-6",
    version: "1.1.5",
    description: "JSON for the ES6 era.",
    keywords: [
        "json",
        "es6"
    ],
    author: "d3x0r <d3x0r@github.com>",
    contributors: [
    ],
    type: "commonjs",
    main: "lib/json6.js",
    browser: "dist/index.js",
    exports: {
        '.': {
            browser: "./dist/index.js",
            import: {
                types: "./dist/index-esm.d.mts",
                default: "./lib/index-esm.mjs"
            },
            require: {
                types: "./dist/json6.d.ts",
                default: "./lib/json6.js"
            }
        },
        './lib/require': {
            types: "./dist/require.d.ts",
            default: "./lib/require.js"
        },
        './lib/*.js': {
            types: "./dist/*.d.ts",
            default: "./lib/*.js"
        },
        './lib/*.mjs': {
            types: "./dist/*.d.mts",
            default: "./lib/*.mjs"
        },
        './dist/*': "./dist/*",
        './package.json': "./package.json"
    },
    bin: "lib/cli.js",
    files: [
        "dist/",
        "lib/"
    ],
    dependencies: {},
    devDependencies: {
        '@arethetypeswrong/cli': 'latest',
        '@babel/core': '^7.0.0',
        '@babel/preset-env': '^7.0.0',
        '@eslint/js': 'latest',
        '@rollup/plugin-babel': 'latest',
        '@rollup/plugin-commonjs': 'latest',
        '@rollup/plugin-node-resolve': 'latest',
        "@rollup/plugin-strip": 'latest',
        '@rollup/plugin-terser': 'latest',
        '@types/babel__core': 'latest',
        '@types/node': 'latest',
        '@types/mocha': 'latest',
        '@types/chai': 'latest',
        acorn:'latest',
        chai: 'latest',
        'core-js': 'latest',
        eslint: 'latest',
        globals: 'latest',
        husky: 'latest',
        'lint-staged': 'latest',
        mocha:'latest',
        nyc:'latest',
        rollup: 'latest',
        typescript: 'latest'
    },
    nyc: {
        check-coverage: true,
        statements: 100,
        branches: 100,
        functions: 100,
        lines: 100,
        ignore-class-method: ['log'],
        reporter: [
            'lcov',
            'text'
        ]
    },
    scripts: {
        attw: "attw --profile node16 --pack .",
        tsc: "tsc",
        'tsc-prod': "tsc -p tsconfig-prod.json",
        prepack: "npm run test-lite",
        lint: "eslint --cache .",
        build: "node build/src-to-lib.js && node ./lib/cli.js -c package.json6 && rollup -c && tsc -p tsconfig-prod.json",
        'mocha-lite': 'mocha --require ./lib/require.js "test/**/*.js"',
        'mocha': 'node --import ./lib/register.mjs ./node_modules/mocha/lib/cli/cli.js --require ./lib/require.js --recursive',
        'nyc-lite': 'nyc npm run mocha-lite',
        nyc: 'nyc npm run mocha',
        'test-lite': 'npm run lint && npm run build && npm run nyc-lite',
        test: 'npm run lint && npm run build && npm run nyc'
    },
    homepage: "http://npmjs.org/package/json-6/",
    engines: {
        node: ">=10.0.0"
    },
    bugs: "https://github.com/d3x0r/json6/issues",
    license: "MIT",
    repository: {
        type: "git",
        url: "https://github.com/d3x0r/json6"
    },
    husky: {
        hooks: {
            'pre-push': 'npm run test-lite',
            'pre-commit': 'lint-staged'
        }
    },
    'lint-staged': {
        '*.js': 'eslint --cache --fix'
    },
    allowScripts: {
        'core-js@3.50.0': true,
        'fsevents@2.3.3': true
    }
}
