{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "resolveJsonModule": true,
        "strict": true,
        "target": "es6",
        "rootDir": "lib",
        "outDir": "dist"
    },
    "include": ["lib/**/*.js", "lib/**/*.mjs", "lib/**/*.d.ts"],
    "exclude": ["node_modules"]
}
